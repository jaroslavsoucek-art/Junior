rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Data klubu jsou pod dlouhým náhodným kódem (kód klubu). Kdo zná kód, čte i píše.
    // Anonymní přihlášení jen brání přístupu bez klienta appky a hrubé síle.
    match /teams/{code}/squads/{squad} {
      allow read, write: if request.auth != null
        && code.size() >= 16 && code.size() <= 64
        && (squad == 'A' || squad == 'B')
        && (request.method == 'get' || (
             request.resource.data.json is string
             && request.resource.data.json.size() < 950000
             && request.resource.data.updatedAt is int
             && request.resource.data.device is string
             && request.resource.data.team in ['A', 'B']));
    }
  }
}
