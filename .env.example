# Volitelné: Firebase pro sdílení dat mezi telefony. Vlož celý objekt firebaseConfig jako JSON na jeden řádek.
# Na Netlify: Site configuration → Environment variables → VITE_FIREBASE_CONFIG.
VITE_FIREBASE_CONFIG={"apiKey":"…","authDomain":"…","projectId":"…","storageBucket":"…","messagingSenderId":"…","appId":"…"}
